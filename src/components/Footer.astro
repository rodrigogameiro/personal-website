---
import Sep from './Sep.astro';
import { person } from '../data/profile';
import { formatMonthYear, yearOf } from '../lib/site';
import { siteConfig } from '../site.config';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>
      © {yearOf(siteConfig.dateModified)} {person.name}
    </p>
    <p>
      Updated{' '}
      <time datetime={siteConfig.dateModified}>{formatMonthYear(siteConfig.dateModified)}</time>
      <Sep />
      <a href={siteConfig.repository}>Source</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem calc(2.5rem + env(safe-area-inset-bottom));
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .footer-inner a {
    color: inherit;
  }

  .footer-inner a:hover {
    color: var(--fg);
  }
</style>
