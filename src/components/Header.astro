---
import Icon from './Icon.astro';
import { person } from '../data/profile';

const links = [
  { href: '/publications/', label: 'Publications' },
  { href: '/#contact', label: 'Contact', hideOnNarrow: true },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => !href.includes('#') && path === href;
---

<header class="site-header">
  <nav class="nav glass glass--blur" aria-label="Primary">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {person.name}
    </a>
    <div class="nav-end">
      <ul class="nav-links">
        {links.map((link) => (
          <li class:list={{ 'hide-narrow': link.hideOnNarrow }}>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      {/* Wired up by the theme script in BaseLayout, and hidden until it has run. */}
      <button
        type="button"
        class="theme-switch"
        role="switch"
        aria-checked="false"
        data-theme-switch
      >
        <span class="visually-hidden">Dark mode</span>
        <span class="icon-moon">
          <Icon name="moon" size={18} />
        </span>
        <span class="icon-sun">
          <Icon name="sun" size={18} />
        </span>
      </button>
    </div>
  </nav>
</header>

<style>
  /*
   * The wrapper must not create a backdrop root (no filter, opacity, mask,
   * will-change or view-transition-name here), or the nav's blur would only
   * see the wrapper itself. The transition name therefore sits on the nav.
   */
  .site-header {
    position: fixed;
    top: max(0.75rem, env(safe-area-inset-top));
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 0.75rem;
    pointer-events: none;
  }

  .nav {
    view-transition-name: site-nav;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100%, calc(var(--measure) + 2rem));
    min-height: 3.25rem;
    padding: 0.375rem 0.375rem 0.375rem 1.25rem;
    border-radius: var(--radius-pill);
  }

  .brand {
    min-width: 0;
    overflow: hidden;
    color: var(--fg);
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-end,
  .nav-links {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-links {
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 0.9rem;
    border-radius: var(--radius-pill);
    color: var(--fg);
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  .nav-links a:hover,
  .theme-switch:hover {
    background-color: var(--glass-hover);
  }

  /* The current page sits in a brighter capsule, like a selected tab. A fill, not glass on glass. */
  .nav-links a[aria-current='page'] {
    background-color: var(--glass-current);
    box-shadow: 0 1px 3px light-dark(rgb(20 24 40 / 0.12), rgb(0 0 0 / 0.35));
  }

  /* The switch needs the theme script, so it appears only once that script has set data-theme. */
  .theme-switch {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: background-color 200ms ease;
  }

  :global(:root[data-theme]) .theme-switch {
    display: inline-flex;
  }

  /* The moon offers dark mode; in dark mode the sun offers light mode. */
  .icon-moon {
    display: block;
  }

  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  @media (forced-colors: active) {
    .nav-links a[aria-current='page'] {
      forced-color-adjust: none;
      background-color: Highlight;
      color: HighlightText;
    }
  }

  /* Phones: "Contact" (also at the end of the home page) gives way so the name is never cut. */
  @media (max-width: 30rem) {
    .hide-narrow {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .nav {
      padding-left: 1rem;
    }
    .nav-links a {
      padding-inline: 0.75rem;
    }
  }

  /* Smallest phones (320 px): tighten so nothing is clipped (WCAG 1.4.10). */
  @media (max-width: 22.5rem) {
    .nav {
      gap: 0.5rem;
      padding-left: 0.875rem;
    }
    .brand {
      font-size: 1.0625rem;
    }
    .nav-links a {
      padding-inline: 0.6rem;
      font-size: 0.875rem;
    }
  }

  @media (prefers-contrast: more) {
    .nav-links a,
    .brand,
    .theme-switch {
      color: inherit;
    }
    .nav-links a[aria-current='page'] {
      background-color: light-dark(#000, #fff);
      color: light-dark(#fff, #000);
      box-shadow: none;
    }
  }
</style>
