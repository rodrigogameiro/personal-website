---
import { createHash } from 'node:crypto';
import { Font } from 'astro:assets';
import themeScript from '../scripts/theme.js?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person, profiles } from '../data/profile';
import { absoluteUrl } from '../lib/site';
import { siteConfig } from '../site.config';
import '../styles/global.css';

interface Props {
  /** Full document title. */
  title: string;
  description: string;
  /** Open Graph type: "profile" on the home page, "website" elsewhere. */
  ogType?: 'profile' | 'website';
  /** JSON-LD object(s) for this page. */
  schema?: object;
  noindex?: boolean;
}

const { title, description, ogType = 'website', schema, noindex = false } = Astro.props;

// A page that must not be indexed (the 404 page) gets no canonical URL.
const canonical = noindex ? undefined : absoluteUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl('/og.jpg', Astro.site);

// The theme script is inlined so it runs before the first paint. Astro's CSP does
// not hash is:inline scripts, so its hash is added here, from the same text.
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(themeScript).digest('base64')}`);
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={person.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f9fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111217" />

    {/* Must follow the color-scheme and theme-color tags, which it updates. */}
    <script is:inline set:html={themeScript} />
    {/* Preload only the upright faces used above the fold; italics load on demand. */}
    <Font cssVariable="--font-inter" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-newsreader" preload />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Portrait of ${person.name}`} />
    {ogType === 'profile' && (
      <>
        <meta property="profile:first_name" content={person.givenName} />
        <meta property="profile:last_name" content={person.familyName} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.twitterHandle} />
    <meta name="twitter:creator" content={siteConfig.twitterHandle} />

    {profiles.map((profile) => (
      <link rel="me" href={profile.url} />
    ))}

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="ambient" aria-hidden="true"></div>
    <Header />
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
