{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "Personal academic website of Rodrigo Gameiro, MD, MPH.",
  "license": "MIT",
  "author": "Rodrigo Gameiro",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigogameiro/personal-website.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check": "astro check",
    "lint": "eslint .",
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --write --ignore-unknown",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --check --ignore-unknown",
    "icons": "node scripts/build-icons.mjs",
    "validate:html": "html-validate dist",
    "validate:links": "linkinator dist",
    "lighthouse": "lhci autorun",
    "verify": "npm run format:check && npm run lint && npm run check && npm run build && npm run validate:html && npm run validate:links"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.4.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource/newsreader": "^5.3.0",
    "@lhci/cli": "^0.16.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "html-validate": "^11.22.1",
    "linkinator": "^8.1.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "wrangler": "4.168.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "^11.0.1"
    },
    "linkinator": {
      "glob": "^14.0.2"
    }
  }
}
